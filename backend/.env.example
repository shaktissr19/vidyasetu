# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidyasetu_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_32chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── AWS S3 ───────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
S3_BUCKET_NAME=vidyasetu-content

# ── SMS / OTP (Kaleyra / 2Factor) ────────────────────────────
SMS_PROVIDER=kaleyra             # kaleyra | twofactor | mock
KALEYRA_API_KEY=your_kaleyra_key
KALEYRA_SID=your_kaleyra_sid
TWOFACTOR_API_KEY=your_2factor_key

# ── WhatsApp (Interakt / Gupshup) ────────────────────────────
WHATSAPP_PROVIDER=interakt       # interakt | gupshup | mock
INTERAKT_API_KEY=your_interakt_key
GUPSHUP_API_KEY=your_gupshup_key
GUPSHUP_APP_NAME=vidyasetu

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── AI / VidyaBot ────────────────────────────────────────────
AI_PROVIDER=openai               # openai | gemini | mock
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=your_gemini_key

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
