# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidyasetu_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_32chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── AWS S3 ───────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
S3_BUCKET_NAME=vidyasetu-content

# ── SMS / OTP ────────────────────────────────────────────────
# Production MUST use kaleyra or twofactor with real credentials.
# mock is for local/test only; production deliberately fails closed.
SMS_PROVIDER=twofactor            # kaleyra | twofactor | mock

# 2Factor OTP API
TWOFACTOR_API_KEY=your_2factor_key
TWOFACTOR_TEMPLATE_NAME=LOGIN_OTP

# Kaleyra India OTP API (required only when SMS_PROVIDER=kaleyra)
KALEYRA_API_DOMAIN=api.in.kaleyra.io
KALEYRA_API_KEY=your_kaleyra_key
KALEYRA_ACCOUNT_SID=your_kaleyra_account_sid
KALEYRA_SENDER_ID=your_approved_sender_id
KALEYRA_TEMPLATE_ID=your_dlt_template_id

# ── WhatsApp (Interakt / Gupshup) ────────────────────────────
WHATSAPP_PROVIDER=interakt       # interakt | gupshup | mock
INTERAKT_API_KEY=your_interakt_key
GUPSHUP_API_KEY=your_gupshup_key
GUPSHUP_APP_NAME=vidyasetu

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── AI / VidyaBot ────────────────────────────────────────────
AI_PROVIDER=openai               # openai | gemini | mock
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=your_gemini_key

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
