# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidyasetu_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_32chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── SMS / OTP (Kaleyra / 2Factor) ────────────────────────────
# Production MUST use kaleyra or twofactor. `mock` is development/test only.
SMS_PROVIDER=twofactor            # kaleyra | twofactor | mock

# 2Factor manual OTP delivery. VidyaSetu generates/verifies the OTP in Redis.
TWOFACTOR_API_KEY=your_2factor_key
# Optional custom OTP template name approved in the 2Factor console.
TWOFACTOR_TEMPLATE_NAME=

# Kaleyra India SMS API (api.in.kaleyra.io)
KALEYRA_API_KEY=your_kaleyra_key
KALEYRA_ACCOUNT_SID=your_kaleyra_account_sid
KALEYRA_SENDER_ID=your_approved_sender_id
# India/TRAI DLT identifiers for the approved OTP message template.
KALEYRA_ENTITY_ID=your_dlt_entity_id
KALEYRA_TEMPLATE_ID=your_dlt_template_id

# Legacy note: old deployments may have used KALEYRA_SID as a sender ID.
# Keep it only during migration; KALEYRA_SENDER_ID is the canonical variable.
KALEYRA_SID=

# ── WhatsApp (Interakt / Gupshup) ────────────────────────────
WHATSAPP_PROVIDER=interakt       # interakt | gupshup | mock
INTERAKT_API_KEY=your_interakt_key
GUPSHUP_API_KEY=your_gupshup_key
GUPSHUP_APP_NAME=vidyasetu

# ── AWS S3 ───────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
S3_BUCKET_NAME=vidyasetu-content

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── AI / VidyaBot ────────────────────────────────────────────
AI_PROVIDER=openai               # openai | gemini | mock
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=your_gemini_key

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
