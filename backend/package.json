{
  "name": "vidyasetu-backend",
  "version": "1.0.0",
  "description": "VidyaSetu Backend API — Node.js / Express",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "psql -U $DB_USER -d $DB_NAME -f ../database/run_all_migrations.sql",
    "db:seed": "psql -U $DB_USER -d $DB_NAME -f ../database/seeds/dev_seed.sql",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1490.0",
    "axios": "^1.6.2",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}