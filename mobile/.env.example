# Set this to the web deployment the app should display. Use staging when
# validating changes before the production website is deployed.
EXPO_PUBLIC_WEB_URL=https://vidyasetu.sbs

# Reserved for future native API screens. The current WebView uses the API
# origin configured by the selected website deployment.
# Android emulator with local backend: http://10.0.2.2:5000/api/v1
# Physical phone: use your computer's LAN IP, e.g. http://192.168.1.20:5000/api/v1
# Hosted API default is https://vidyasetu.sbs/api/v1
EXPO_PUBLIC_API_URL=https://vidyasetu.sbs/api/v1
